{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "8d05e6bd-1996-44ef-8606-307848e3bc00"
  },
  "newProjectRoot": "projects",
  "projects": {
    "esart": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/jost/400.css",
              "node_modules/@fontsource/jost/500.css",
              "node_modules/@fontsource/jost/600.css",
              "node_modules/@fontsource/jost/700.css",
              "node_modules/@fontsource/radio-canada-big/400.css",
              "node_modules/@fontsource/radio-canada-big/400-italic.css",
              "node_modules/@fontsource/radio-canada-big/600.css",
              "node_modules/@fontsource/red-hat-mono/500.css",
              "node_modules/@fontsource/red-hat-mono/600.css",
              "node_modules/material-symbols/outlined.css",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": {
                  "inline": false
                }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "esart:build:production"
            },
            "development": {
              "buildTarget": "esart:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
