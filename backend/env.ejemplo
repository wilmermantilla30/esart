# =============================================================================
# ESART - Variables de entorno de ejemplo
# Copie este archivo como .env y reemplace los valores.
# El archivo .env NUNCA se sube a git (esta en .gitignore).
# =============================================================================

# Entorno de ejecucion: desarrollo | pruebas | produccion
# En produccion se ocultan la documentacion de la API y se exigen cookies seguras.
ENTORNO=desarrollo

# Nivel de detalle de los registros: DEBUG | INFO | WARNING | ERROR
NIVEL_REGISTRO=INFO

# --- Base de datos ---
# Formato: postgresql+asyncpg://USUARIO:CONTRASENA@SERVIDOR:PUERTO/esart_db
# Use un usuario propio de la aplicacion, NUNCA el superusuario postgres.
URL_BASE_DATOS=postgresql+asyncpg://esart_aplicacion:CAMBIAR_CONTRASENA@localhost:5432/esart_db
TAMANO_POOL_CONEXIONES=10
SEGUNDOS_ESPERA_CONEXION=5

# --- Sesion (JWT dentro de cookie httpOnly) ---
# Clave de minimo 32 caracteres. Generela con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_CLAVE_SECRETA=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_MINIMO_32_CARACTERES
MINUTOS_INACTIVIDAD_SESION=30

# Cookie solo por HTTPS. En local sin HTTPS use false.
# EN PRODUCCION DEBE SER true (la aplicacion no arranca si no lo es).
COOKIE_SEGURA=false

# --- Administrador inicial ---
# Se crea al arrancar si no existe. La contrasena se guarda SOLO como hash bcrypt.
# Genere el hash con:
#   python -c "import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass('Contrasena: ').encode(), bcrypt.gensalt(12)).decode())"
# Escriba el hash entre comillas simples (el hash contiene el caracter $).
ADMIN_USUARIO=admin.esart
ADMIN_HASH_CONTRASENA='$2b$12$REEMPLAZAR.ESTE.VALOR.POR.EL.HASH.GENERADO.CON.BCRYPT.'
